---
---
<div id="{{ entry.key }}" class="pub-entry">
  <div class="author">
    {%- for author in entry.author_array -%}
      {{ author.first }} {{ author.last }}{% unless forloop.last %}, {% endunless %}
    {%- endfor -%}
  </div>
  <div class="title">{{ entry.title }}</div>
  <div class="periodical">
    {%- if entry.journal or entry.booktitle %}<em>{{ entry.journal }}{{ entry.booktitle }}</em>, {% endif -%}
    {{ entry.year }}
  </div>
  {%- if entry.additional_info %}
  <div class="periodical">{{ entry.additional_info }}</div>
  {%- endif %}
</div>
